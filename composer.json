{
    "name": "boone-studios/laravel-surrealdb",
    "description": "Integrates SurrealDB with the Laravel framework",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "eloquent",
        "surrealdb",
        "database",
        "model"
    ],
    "authors": [
        {
            "name": "Boone Studios, LLC",
            "email": "support@BooneStudios.org",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/boone-studios/laravel-surrealdb",
    "require": {
        "php": "^8.2",
        "illuminate/container": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "surrealdb/surrealdb.php": "^1.0"
    },
    "require-dev": {
        "doctrine/dbal": "^2.13.3 || ^3.1.4 || ^4.2.1",
        "ergebnis/composer-normalize": "^2.44",
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.17",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.5",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "BooneStudios\\Surreal\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BooneStudios\\Surreal\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "BooneStudios\\Surreal\\SurrealServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format-check": "vendor/bin/pint --test",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage"
    }
}
